CREATE TABLE departamentos (
codigo INTEGER PRIMARY KEY AUTOINCREMENT,
nombre TEXT NOT NULL
);

CREATE TABLE empleados (
legajo INTEGER PRIMARY KEY AUTOINCREMENT,
fecha_de_nacimiento DATE NOT NULL,
nombre TEXT NOT NULL,
segundo_nombre TEXT,
apellido TEXT NOT NULL,
codigo INTEGER,
FOREIGN KEY (codigo) REFERENCES departamentos (codigo) ON DELETE SET NULL
);

CREATE TABLE telefonos (
numero INTEGER PRIMARY KEY,
legajo INTEGER NOT NULL,
FOREIGN KEY (legajo) REFERENCES empleados (legajo) ON DELETE CASCADE
);

INSERT INTO departamentos (nombre)
VALUES
('finanzas'), ('Recursos Humanos');

INSERT INTO empleados (legajo, fecha_de_nacimiento, nombre, segundo_nombre, apellido, codigo)
VALUES
(123456, '2005-08-12', 'Jose', 'Fernando', 'Martinez', 1),
(1002, '1988-11-22', 'María', NULL, 'Gomez', 1),
(1003, '1995-03-10', 'Lucas', 'Fernández', 'Martín', 2);

INSERT INTO telefonos (numero, legajo) VALUES
('+541144445555', 123456),
('+541166667777', 123456),
('+541122223333', 1002),
('+541199998888', 1003);

SELECT
	e.legajo,
	e.nombre,
	e.segundo_nombre,
	e.apellido,
	e.fecha_de_nacimiento,
	d.nombre AS departamento,
	t.numero AS telefono
FROM empleados e
INNER JOIN departamentos d ON e.codigo = d.codigo
INNER JOIN telefonos t ON e.legajo = t.legajo;

SELECT
	e.legajo,
	e.nombre,
	e.segundo_nombre,
	e.apellido,
	e.fecha_de_nacimiento,
	d.nombre AS departamento
FROM empleados e
LEFT JOIN departamentos d ON e.codigo = d.codigo;

SELECT
	e.legajo,
	e.nombre,
	e.segundo_nombre,
	e.apellido,
	e.fecha_de_nacimiento,
	d.nombre AS departamento
FROM empleados e
RIGHT JOIN departamentos d ON e.codigo = d.codigo;

SELECT
	e.legajo,
	e.nombre,
	e.segundo_nombre,
	e.apellido,
	e.fecha_de_nacimiento,
	d.nombre AS departamento
FROM empleados e
FULL OUTER JOIN departamentos d ON e.codigo = d.codigo;

SELECT
	e.legajo,
	e.nombre,
	e.segundo_nombre,
	e.apellido,
	e.fecha_de_nacimiento,
	t.numero AS telefono
FROM empleados e
FULL OUTER JOIN telefonos t ON e.legajo = t.legajo;</sql><current_tab id="0"/></tab_sql></sqlb_project>
